{
  "name": "moshimoshi",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "WATCHPACK_IGNORED=\"**/01_PRODUCTION_DOCS/**,**/moshi-comics/**,**/notebooklm-backups/**,**/docs/**,**/.git/**\" node ./scripts/dev-with-backup.js",
    "dev:no-backup": "WATCHPACK_IGNORED=\"**/01_PRODUCTION_DOCS/**,**/moshi-comics/**,**/notebooklm-backups/**,**/docs/**,**/.git/**\" concurrently \"next dev\" \"npm run notebooklm:watch\"",
    "dev:simple": "WATCHPACK_IGNORED=\"**/01_PRODUCTION_DOCS/**,**/moshi-comics/**,**/notebooklm-backups/**,**/docs/**,**/.git/**\" next dev",
    "build": "rm -rf .next/cache && next build && node scripts/pwa/inject-precache.mjs",
    "build:full": "rm -rf .next && next build && node scripts/pwa/inject-precache.mjs",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "test": "jest --passWithNoTests",
    "test:unit": "jest --testPathIgnorePatterns=e2e --passWithNoTests",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:chrome": "playwright test --project=chromium",
    "test:e2e:firefox": "playwright test --project=firefox",
    "test:e2e:webkit": "playwright test --project=webkit",
    "test:all": "npm run test:unit && npm run test:e2e",
    "test:coverage": "jest --coverage --passWithNoTests",
    "test:ci": "jest --ci --coverage --maxWorkers=50% --passWithNoTests",
    "test:watch": "jest --watch --passWithNoTests",
    "test:unit:coverage": "jest --testPathIgnorePatterns=e2e --coverage --passWithNoTests",
    "test:full": "npm run test:unit && npm run test:e2e",
    "test:quick": "jest --testPathIgnorePatterns=e2e --passWithNoTests --maxWorkers=100%",
    "test:ci:unit": "jest --ci --coverage --maxWorkers=50% --passWithNoTests --testPathIgnorePatterns=e2e",
    "test:ci:e2e": "playwright test --project=chromium",
    "gen:entitlements": "tsx scripts/gen-entitlements.ts",
    "docs:aggregate": "node scripts/docs-aggregator.js",
    "docs:watch": "node scripts/docs-aggregator.js --watch",
    "notebooklm:sync": "node scripts/notebooklm-sync.js -o ./moshimoshi-docs.md",
    "notebooklm:watch": "node scripts/notebooklm-sync.js --watch -o ./moshimoshi-docs.md",
    "notebooklm:clean": "node scripts/notebooklm-sync.js --clean",
    "migrate:quiz": "tsx src/scripts/migrate-quiz-data.ts",
    "migrate:quiz:dry-run": "tsx src/scripts/migrate-quiz-data.ts --dry-run",
    "add-furigana": "tsx src/scripts/add-comic-furigana.ts --live",
    "add-furigana:dry-run": "tsx src/scripts/add-comic-furigana.ts",
    "prepare": "husky"
  },
