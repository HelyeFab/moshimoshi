rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() &&
        request.auth.token.admin == true;
    }

    function hasValidTimestamp() {
      return request.resource.data.keys().hasAll(['createdAt', 'updatedAt']) &&
        request.resource.data.createdAt is timestamp &&
        request.resource.data.updatedAt is timestamp;
    }
    
    function isValidVersion() {
      return request.resource.data.version == resource.data.version + 1;
    }
    
    // Review items - users can only access their own
    match /review_items/{itemId} {
      allow read: if isOwner(resource.data.userId);
      
      allow create: if isOwner(request.resource.data.userId) &&
        request.resource.data.keys().hasAll(['userId', 'contentType', 'contentId', 'status']) &&
        hasValidTimestamp();
      
      allow update: if isOwner(resource.data.userId) &&
        request.resource.data.userId == resource.data.userId &&
        isValidVersion();
      
      allow delete: if isOwner(resource.data.userId);
    }
    
    // Review sets - handle sharing and public access
    match /review_sets/{setId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        resource.data.isPublic == true ||
        request.auth.uid in resource.data.sharedWith
      );
      
      allow create: if isOwner(request.resource.data.userId) &&
        request.resource.data.keys().hasAll(['userId', 'name', 'category']) &&
        hasValidTimestamp();
      
      allow update: if isOwner(resource.data.userId) &&
        request.resource.data.userId == resource.data.userId;
      
      allow delete: if isOwner(resource.data.userId);
    }
    
    // Review sessions - users can only access their own
    match /review_sessions/{sessionId} {
      allow read: if isOwner(resource.data.userId);
      
      allow create: if isOwner(request.resource.data.userId) &&
        request.resource.data.keys().hasAll(['userId', 'sessionType', 'deviceType']);
      
      allow update: if isOwner(resource.data.userId) &&
        request.resource.data.userId == resource.data.userId;
      
      allow delete: if isOwner(resource.data.userId) || isAdmin();
    }
    
    // Review statistics - users can only access their own
    match /review_statistics/{statId} {
      allow read: if isOwner(resource.data.userId) || 
        (isAuthenticated() && resource.data.isPublic == true);
      
      allow create: if isOwner(request.resource.data.userId);
      
      allow update: if isOwner(resource.data.userId) &&
        request.resource.data.userId == resource.data.userId;
      
      allow delete: if false; // Statistics should never be deleted
    }
    
    // Pinned items - users can only access their own
    match /pinned_items/{pinnedId} {
      allow read: if isOwner(resource.data.userId);
      
      allow create: if isOwner(request.resource.data.userId) &&
        request.resource.data.keys().hasAll(['userId', 'contentType', 'contentId']);
      
      allow update: if isOwner(resource.data.userId) &&
        request.resource.data.userId == resource.data.userId;
      
      allow delete: if isOwner(resource.data.userId);
    }
    
    // Review presets - read-only for regular users, writable by admins
    match /review_presets/{presetId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    
    // User profiles with subscription facts (Entitlements v2)
    match /users/{userId} {
      // Allow users to read their own profile (INCLUDING subscription data)
      allow read: if isOwner(userId) || isAdmin();

      // Allow user creation with minimal requirements (profile can be created by server or client)
      allow create: if isOwner(userId);

      // Allow updates but protect subscription facts, onboarding, and intro status
      allow update: if isOwner(userId) &&
        // Users cannot modify their subscription facts, onboarding, or intro status directly
        // These fields can only be modified server-side via Admin SDK
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['subscription', 'stripeCustomerId', 'onboarding', 'intro']));

      allow delete: if false; // Users should be soft-deleted
    }

    // Flashcard sessions (premium sync) - enforce ownership if ever accessed client-side
    match /flashcardSessions/{sessionId} {
      allow read: if isOwner(resource.data.userId);
      allow write: if false; // Only server (Admin SDK) should write
    }

    // Flashcard session analytics (daily aggregates)
    match /flashcardSessionAnalytics/{userId}/days/{date} {
      allow read: if isOwner(userId);
      allow write: if false; // Only server writes aggregates
    }

    // Flashcard active sessions (premium sync via server only)
    match /users/{userId}/flashcardActiveSessions/{deckId} {
      allow read: if isOwner(userId);
      allow write: if false; // Only server writes
    }

    // Flashcard daily goals (premium sync)
    match /flashcardGoals/{userId} {
      allow read: if isOwner(userId);
      allow write: if isOwner(request.resource.data.userId);
    }

    // Flashcard study recommendations (premium sync)
    match /flashcardRecommendations/{userId} {
      allow read: if isOwner(userId);
      allow write: if isOwner(request.resource.data.userId);
    }

    // Blast Mode sessions (premium sync via server only)
    match /blastSessions/{sessionId} {
      allow read: if isOwner(resource.data.userId);
      allow write: if false; // Only server (Admin SDK) should write
    }

    // Blast Mode lesson progress (premium sync via server only)
    match /blastLessonProgress/{lessonId} {
      allow read: if isOwner(resource.data.userId);
      allow write: if false; // Only server (Admin SDK) should write
    }

    // Flashcard deleted cards (premium sync)
    match /flashcardDeckDeletions/{userId}/decks/{deckId} {
      allow read: if isOwner(userId);
      allow write: if isOwner(request.resource.data.userId);
    }

    // R2 backup metadata for Anki decks
    match /anki_r2_backups/{deckId} {
      allow read: if isOwner(resource.data.userId);
      allow write: if isOwner(request.resource.data.userId);
    }
    
    // Usage collection - track feature usage (Entitlements v2)
    match /usage/{userId}/daily/{date} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if false; // Only server can write usage data
    }
    
    // Entitlement decision logs - for auditing
    match /logs/entitlements/{document} {
      allow read: if isAdmin();
      allow write: if false; // Only server can write
    }
    
    // Subscription update logs
    match /logs/subscription_updates/{document} {
      allow read: if isAdmin();
      allow write: if false; // Only server can write
    }
    
    // Stripe customer mapping
    match /stripe_customers/{document} {
      allow read: if false; // Only server can read
      allow write: if false; // Only server can write
    }
    
    // Processed events for idempotency
    match /processed_events/{eventId} {
      allow read: if false; // Only server can read
      allow write: if false; // Only server can write
    }
    
    // Stripe event logs
    match /stripe_events/{eventId} {
      allow read: if isAdmin();
      allow write: if false; // Only server can write
    }
    
    // Idempotency records
    match /idempotency/{key} {
      allow read: if false; // Only server can read
      allow write: if false; // Only server can write
    }
    
    // Content collections (public read for learning materials)
    match /content/hiragana/{document} {
      allow read: if true; // Public content
      allow write: if isAdmin();
    }
    
    match /content/katakana/{document} {
      allow read: if true; // Public content
      allow write: if isAdmin();
    }
    
    // Pokemon collection - users can only access their own
    match /pokemon/{userId} {
      allow read: if isOwner(userId);

      allow create: if isOwner(userId) &&
        request.resource.data.keys().hasAll(['userId', 'caught', 'totalCaught']);

      allow update: if isOwner(userId) &&
        request.resource.data.userId == resource.data.userId;

      allow delete: if false; // Pokemon data should not be deleted
    }

    // Universal progress collections - users can only access their own
    // Supports any content type: hiragana, katakana, kanji, vocabulary, sentences, etc.
    match /users/{userId}/progress/{contentType} {
      allow read: if isOwner(userId);

      allow create: if isOwner(userId) &&
        request.resource.data.userId == userId;

      allow update: if isOwner(userId) &&
        request.resource.data.userId == userId;

      allow delete: if false; // Progress data should not be deleted
    }

    // Session tracking for analytics
    match /users/{userId}/sessions/{sessionId} {
      allow read: if isOwner(userId);

      allow create: if isOwner(userId) &&
        request.resource.data.userId == userId;

      allow update: if isOwner(userId) &&
        request.resource.data.userId == userId;

      allow delete: if false; // Session data should not be deleted
    }

    // ========================================
    // Top-level Deck Collections
    // Using flat structure with userId field
    // ========================================

    // Flashcard decks - top-level collection with userId field
    match /flashcardDecks/{deckId} {
      // Users can read their own flashcard decks
      allow read: if isAuthenticated() &&
        resource.data.userId == request.auth.uid;

      // Writes are handled server-side via Admin SDK
      // This ensures premium-only writes are enforced
      allow write: if false;
    }

    // Anki decks - top-level collection with userId field
    match /ankiDecks/{deckId} {
      // Users can read their own Anki decks
      allow read: if isAuthenticated() &&
        resource.data.userId == request.auth.uid;

      // Writes are handled server-side via Admin SDK
      // This ensures premium-only writes are enforced
      allow write: if false;
    }

    // User flashcard decks (R2-backed) - top-level collection with userId field
    match /userFlashcardDecks/{deckId} {
      // Users can read their own user-created flashcard decks
      allow read: if isAuthenticated() &&
        resource.data.userId == request.auth.uid;

      // Writes are handled server-side via Admin SDK
      // This ensures premium-only writes are enforced (R2 storage)
      allow write: if false;
    }

    // R2 usage tracking - top-level collection (per user)
    match /r2Usage/{userId} {
      // Users can read their own R2 usage statistics
      allow read: if isOwner(userId);

      // Writes are handled server-side via Admin SDK
      allow write: if false;
    }

    // Universal review history - tracks ALL learning events
    match /users/{userId}/review_history/{entryId} {
      allow read: if isOwner(userId);

      allow create: if isOwner(userId) &&
        request.resource.data.userId == userId &&
        request.resource.data.keys().hasAll(['contentType', 'contentId', 'event', 'timestamp']);

      allow update: if false; // Review history is immutable

      allow delete: if false; // Review history should never be deleted
    }

    // User preferences collection - structured under users collection
    match /users/{userId}/preferences/{document} {
      // Only the user can read their own preferences
      allow read: if isOwner(userId);

      // User can create preferences if authenticated and it's their own data
      allow create: if isOwner(userId) &&
        request.resource.data.userId == userId &&
        request.resource.data.keys().hasAll(['userId', 'updatedAt']);

      // User can update their own preferences
      allow update: if isOwner(userId) &&
        request.resource.data.userId == userId &&
        request.resource.data.userId == resource.data.userId;

      // Preferences should not be deleted (only updated)
      allow delete: if false;
    }

    // Learning Village layout (per-user district/stall order)
    match /users/{userId}/villageLayout/{document} {
      // Users can read their own layout
      allow read: if isOwner(userId);

      // Users can create or update their own layout
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);

      // Do not allow deletes (keep history/intact)
      allow delete: if false;
    }

    // Achievement data - Premium users can sync their achievements
    match /users/{userId}/achievements/{document} {
      // Users can read their own achievements
      allow read: if isOwner(userId);

      // Only premium users can write (sync) their achievements
      // Check subscription in the user document, not in auth token
      // Accept both premium_monthly and premium_yearly
      allow create: if isOwner(userId) &&
        (get(/databases/$(database)/documents/users/$(userId)).data.subscription.plan == 'premium_monthly' ||
         get(/databases/$(database)/documents/users/$(userId)).data.subscription.plan == 'premium_yearly') &&
        request.resource.data.keys().hasAll(['lastUpdated']);

      allow update: if isOwner(userId) &&
        (get(/databases/$(database)/documents/users/$(userId)).data.subscription.plan == 'premium_monthly' ||
         get(/databases/$(database)/documents/users/$(userId)).data.subscription.plan == 'premium_yearly') &&
        request.resource.data.keys().hasAll(['lastUpdated']);

      // Achievements should not be deleted
      allow delete: if false;
    }

    // Audit logs - write-only for system, read-only for admins
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false; // Only server-side writes
    }

    // Push notification tokens - users can manage their own FCM tokens
    match /notifications_tokens/{userId} {
      // Users can read their own token document
      allow read: if isOwner(userId);

      // Users can create their token document
      allow create: if isOwner(userId) &&
        request.resource.data.keys().hasAll(['userId', 'fcm_token']);

      // Users can update their token document
      allow update: if isOwner(userId) &&
        request.resource.data.userId == userId;

      // Users can delete their token document (for logout/unsubscribe)
      allow delete: if isOwner(userId);
    }

    // Notification preferences - users can manage their own preferences
    match /notifications_preferences/{userId} {
      allow read: if isOwner(userId);

      allow create: if isOwner(userId);

      allow update: if isOwner(userId);

      allow delete: if false; // Preferences should not be deleted
    }

    // Notification queue - scheduled notifications
    match /notifications_queue/{notificationId} {
      // Users can read their own scheduled notifications
      allow read: if isAuthenticated() &&
        resource.data.userId == request.auth.uid;

      // Users can create scheduled notifications for themselves
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.keys().hasAll(['userId', 'notification', 'scheduledFor', 'status']);

      // Users can update their own scheduled notifications (e.g., cancel)
      allow update: if isAuthenticated() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.userId == request.auth.uid;

      allow delete: if false; // Don't delete, just update status to cancelled
    }

    // Notification logs - server writes, users read their own
    match /notifications_log/{logId} {
      // Users can read their own notification logs
      allow read: if isAuthenticated() &&
        resource.data.userId == request.auth.uid;

      // Only server can write notification logs
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid;

      allow update, delete: if false; // Logs are immutable
    }

    // Books collection - Published books (public read, admin write via server)
    match /books/{bookId} {
      // Anyone can read published books
      allow read: if resource.data.status == 'published';

      // Only server (Admin SDK) can write
      // Client-side writes are blocked
      allow write: if false;
    }

    // Book drafts collection - Admin read (for real-time progress), server-only writes
    match /book_drafts/{draftId} {
      // Allow admins to read drafts (for generation progress tracking)
      allow read: if isAdmin();

      // Only server (Admin SDK) can write
      allow write: if false;
    }

    // Translation cache collections - server-side optimization
    // These collections cache AI translations to reduce API costs
    match /translations/{translationId} {
      // Allow server-side reads and writes via Admin SDK
      // Client-side access blocked for security
      allow read, write: if false;
    }

    match /translation_cache/{cacheId} {
      // Allow server-side reads and writes via Admin SDK
      // Client-side access blocked for security
      allow read, write: if false;
    }

    // AI cache collection - server-side caching system
    match /ai_cache/{cacheId} {
      // Allow server-side reads and writes via Admin SDK
      // Client-side access blocked for security
      allow read, write: if false;
    }

    // Stories collection - public read for published stories
    match /stories/{storyId} {
      // Anyone can read published stories
      allow read: if resource.data.status == 'published';

      // Only admin can write (create/update/delete)
      allow write: if isAdmin();
    }

    // Story progress collection - users can track their reading progress
    match /storyProgress/{progressId} {
      // Users can read their own progress
      allow read: if isAuthenticated() &&
        resource.data.userId == request.auth.uid;

      // Users can create progress for themselves
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid;

      // Users can update their own progress
      allow update: if isAuthenticated() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.userId == request.auth.uid;

      // Progress should not be deleted
      allow delete: if false;
    }

    // News progress collection - users can track their news reading progress
    match /news_progress/{progressId} {
      // Users can read their own progress
      allow read: if isAuthenticated() &&
        resource.data.userId == request.auth.uid;

      // Users can create progress for themselves
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid;

      // Users can update their own progress
      allow update: if isAuthenticated() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.userId == request.auth.uid;

      // Progress should not be deleted
      allow delete: if false;
    }

    // Book progress collection - users can track their book reading progress
    match /bookProgress/{progressId} {
      // Users can read their own progress
      allow read: if isAuthenticated() &&
        resource.data.userId == request.auth.uid;

      // Users can create progress for themselves
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid;

      // Users can update their own progress
      allow update: if isAuthenticated() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.userId == request.auth.uid;

      // Progress should not be deleted
      allow delete: if false;
    }

    // MoodBoards collection - public read for active, admin write via server
    match /moodBoards/{boardId} {
      // Anyone can read active moodboards (public learning content)
      allow read: if resource.data.isActive == true;

      // Writes handled via Admin SDK (API routes) - client writes blocked
      allow write: if false;
    }

    // Book word explanations - pre-cached word explanations for instant lookups
    match /book_word_explanations/{bookId} {
      // Public read: clients do not use Firebase Auth; data is pre-generated and safe to read
      allow read: if true;
      // Writes handled via Admin SDK (book generation API) - client writes blocked
      allow write: if false;
    }

    // News article word explanations - pre-cached word explanations
    match /news_article_word_explanations/{articleId} {
      // Public read: clients do not use Firebase Auth; data is pre-generated and safe to read
      allow read: if true;
      // Writes handled via Admin SDK - client writes blocked
      allow write: if false;
    }

    // News article sentence translations/audio (pre-cached)
    match /news_article_translations/{articleId} {
      // Public read: data is pre-generated for faster client loads
      allow read: if true;
      // Writes handled via Admin SDK / backend jobs only
      allow write: if false;
    }

    // Story sentence data (pre-cached per page for story reader)
    match /story_sentence_data/{storyId} {
      allow read: if true;
      allow write: if false;
    }

    // Book sentence data (pre-cached for book reader)
    match /book_sentence_data/{bookId} {
      allow read: if true;
      allow write: if false;
    }

    // Story word explanations - pre-cached word explanations for multi-page stories
    match /story_word_explanations/{storyId} {
      allow read: if true;
      allow write: if false;
    }

    // Video word explanations - pre-cached word explanations for transcripts (moshiplayer)
    match /video_word_explanations/{videoId} {
      allow read: if true;
      allow write: if false;
    }

    // YouTube word explanations - pre-cached word explanations for YouTube transcripts
    match /youtube_word_explanations/{videoId} {
      allow read: if true;
      allow write: if false;
    }

    // Flashcard word explanations - pre-cached vocabulary explanations for decks/cards
    match /flashcard_word_explanations/{cardId} {
      allow read: if true;
      allow write: if false;
    }

    // ========================================
    // Comics Collections - "Moshi Goes to Japan"
    // ========================================

    // Comic series info - public read
    match /comic_series/{seriesId} {
      allow read: if true;
      allow write: if false; // Server-only via Admin SDK
    }

    // Published comic episodes - public read for published
    match /comics/{episodeId} {
      allow read: if resource.data.status == 'published';
      allow write: if false; // Server-only via Admin SDK
    }

    // Comic drafts - server only
    match /comic_drafts/{draftId} {
      allow read, write: if false; // Server-only via Admin SDK
    }

    // Saved character references - server only
    match /saved_characters/{characterId} {
      allow read, write: if false; // Server-only via Admin SDK
    }

    // Comic generation logs - admin read only
    match /comic_generation_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false; // Server-only via Admin SDK
    }

    // Comic generation queue - admin managed scheduling
    match /comic_generation_queue/{queueId} {
      allow read: if isAdmin();
      allow write: if false; // Server-only via Admin SDK (API routes)
    }

    // Comic progress - users can track their reading progress
    match /comic_progress/{progressId} {
      allow read: if isAuthenticated() &&
        resource.data.userId == request.auth.uid;

      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid;

      allow update: if isAuthenticated() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.userId == request.auth.uid;

      allow delete: if false;
    }

    // Comic word explanations - pre-cached vocabulary explanations
    match /comic_word_explanations/{episodeId} {
      allow read: if true;
      allow write: if false; // Server-only via Admin SDK
    }

    // Quiz progress collection - tracks quiz completions for stories/comics
    // Used to prevent double XP rewards on retakes
    match /quiz_progress/{progressId} {
      // Users can read their own quiz progress
      allow read: if isAuthenticated() &&
        resource.data.userId == request.auth.uid;

      // Users can create quiz progress for themselves
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid;

      // Users can update their own quiz progress
      allow update: if isAuthenticated() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.userId == request.auth.uid;

      // Quiz progress should not be deleted
      allow delete: if false;
    }

    // ========================================
    // Q&A Forum Collections
    // ========================================

    // Q&A Questions - community forum questions
    // IMPORTANT: Available to ALL users (free + premium)
    match /qa_questions/{questionId} {
      // Anyone can read approved questions (including guests)
      // Authors can read their own questions regardless of moderation status
      // Note: Allow list operations, filtering happens in query
      allow read: if true;

      // Any authenticated user can create questions
      // Moderation status will be set by server/client
      allow create: if isAuthenticated() &&
        request.resource.data.author.uid == request.auth.uid &&
        request.resource.data.keys().hasAll(['title', 'content', 'tags', 'author', 'moderationStatus']);

      // Authors can update their own questions
      // Moderation status can be reset to 'pending' by authors (for re-moderation)
      // Any authenticated user can update vote counts
      // Anyone (including guests) can update view count
      allow update: if (
        // Anyone can increment view count (including guests)
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['viewCount']) ||

        // Authenticated users can update vote counts and timestamps
        (isAuthenticated() && (
          // Authors can update their own questions
          (resource.data.author.uid == request.auth.uid &&
           request.resource.data.author.uid == request.auth.uid &&
           // Can keep same status OR reset to 'pending' for re-moderation
           (request.resource.data.moderationStatus == resource.data.moderationStatus ||
            request.resource.data.moderationStatus == 'pending')) ||

          // Any authenticated user can update ONLY vote counts
          (request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['upvotes', 'downvotes', 'updatedAt']))
        ))
      );

      // Authors can delete their own questions
      allow delete: if isAuthenticated() &&
        resource.data.author.uid == request.auth.uid;
    }

    // Q&A Answers - community forum answers
    // IMPORTANT: Available to ALL users (free + premium)
    match /qa_answers/{answerId} {
      // Anyone can read approved answers (including guests)
      // Authors can read their own answers regardless of moderation status
      // Note: Allow list operations, filtering happens in query
      allow read: if true;

      // Any authenticated user can create answers
      allow create: if isAuthenticated() &&
        request.resource.data.author.uid == request.auth.uid &&
        request.resource.data.keys().hasAll(['questionId', 'content', 'author', 'moderationStatus']);

      // Authors can update their own answers
      // Question authors can update accepted status
      // Moderation status can be reset to 'pending' by authors (for re-moderation)
      // Any authenticated user can update vote counts
      allow update: if isAuthenticated() && (
        // Authors can update their own answers (but not accepted status)
        (resource.data.author.uid == request.auth.uid &&
         request.resource.data.author.uid == request.auth.uid &&
         request.resource.data.accepted == resource.data.accepted &&
         // Can keep same status OR reset to 'pending' for re-moderation
         (request.resource.data.moderationStatus == resource.data.moderationStatus ||
          request.resource.data.moderationStatus == 'pending')) ||

        // Question author can mark answer as accepted
        (request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['accepted', 'updatedAt']) &&
         get(/databases/$(database)/documents/qa_questions/$(resource.data.questionId)).data.author.uid == request.auth.uid) ||

        // Any authenticated user can update ONLY vote counts
        (request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['upvotes', 'downvotes', 'updatedAt']))
      );

      // Authors can delete their own answers
      // Question authors can also delete answers on their questions (for cascade delete on question deletion)
      allow delete: if isAuthenticated() && (
        resource.data.author.uid == request.auth.uid ||
        get(/databases/$(database)/documents/qa_questions/$(resource.data.questionId)).data.author.uid == request.auth.uid
      );
    }

    // Q&A Question Votes - voting on questions
    // IMPORTANT: Available to ALL authenticated users (free + premium)
    // RESTRICTION: Users CANNOT vote on their own questions
    match /qa_question_votes/{voteId} {
      // Users can read their own votes (even if document doesn't exist yet)
      // Document ID format: {userId}_{questionId}
      allow read: if isAuthenticated() &&
        voteId.matches('^' + request.auth.uid + '_.*');

      // Users can write (create/update) votes for themselves (but NOT on their own questions)
      // Handles both new votes and vote type changes in transactions
      allow write: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.keys().hasAll(['userId', 'questionId', 'voteType']) &&
        // Prevent voting on own questions
        get(/databases/$(database)/documents/qa_questions/$(request.resource.data.questionId)).data.author.uid != request.auth.uid;

      // Users can delete their own votes (remove vote)
      allow delete: if isAuthenticated() &&
        resource.data.userId == request.auth.uid;
    }

    // Q&A Answer Votes - voting on answers
    // IMPORTANT: Available to ALL authenticated users (free + premium)
    // RESTRICTION: Users CANNOT vote on their own answers
    match /qa_answer_votes/{voteId} {
      // Users can read their own votes (even if document doesn't exist yet)
      // Document ID format: {userId}_{answerId}
      allow read: if isAuthenticated() &&
        voteId.matches('^' + request.auth.uid + '_.*');

      // Users can write (create/update) votes for themselves (but NOT on their own answers)
      // Handles both new votes and vote type changes in transactions
      allow write: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.keys().hasAll(['userId', 'answerId', 'voteType']) &&
        // Prevent voting on own answers
        get(/databases/$(database)/documents/qa_answers/$(request.resource.data.answerId)).data.author.uid != request.auth.uid;

      // Users can delete their own votes (remove vote)
      allow delete: if isAuthenticated() &&
        resource.data.userId == request.auth.uid;
    }

    // DeckMarket - deck catalogue (public reads published only, admin reads via Admin SDK)
    match /deckmarket_decks/{deckId} {
      allow read: if request.auth != null && resource.data.isPublished == true;
      allow write: if false; // Writes via Admin SDK only

      match /versions/{versionId} {
        allow read: if request.auth != null &&
          get(/databases/$(database)/documents/deckmarket_decks/$(deckId)).data.isPublished == true;
        allow write: if false; // Writes via Admin SDK only
      }
    }

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
