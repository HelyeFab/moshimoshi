{
  "id": "269-n4-point-69",
  "version": "1.0.0",
  "title": {
    "ja": "Verb る ところ",
    "romaji": "Verb-ru tokoro",
    "en": "Verb + ところ"
  },
  "jlptLevel": "N4",
  "category": "basic-sentences",
  "explanation": {
    "en": "The grammar point 'Verb る ところ' is used to express that one is just about to do something, or is in the process of doing it. It can be translated as 'just about to' or 'in the middle of' in English.",
    "ja": "「Verb る ところ」は、何かをすぐに行う直前やその行為の最中であることを表現します。英語では、「just about to」とか「in the middle of」と訳せます。"
  },
  "structure": {
    "pattern": "Verb-dictionary form + ところ",
    "components": [
      {
        "part": "Verb-dictionary form",
        "explanation": "The verb in its dictionary form (plain, non-past).",
        "examples": [
          "食べる(taberu)",
          "出かける(dekakeru)"
        ]
      },
      {
        "part": "ところ",
        "explanation": "This word indicates the state or situation of an action.",
        "examples": []
      }
    ]
  },
  "examples": [
