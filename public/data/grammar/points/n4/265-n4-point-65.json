{
  "id": "265-n4-point-65",
  "version": "1.0.0",
  "title": {
    "ja": "Verb ることができる",
    "romaji": "Verb ru koto ga dekiru",
    "en": "Can do (Verb + ことができる)"
  },
  "jlptLevel": "N4",
  "category": "verbs",
  "explanation": {
    "en": "This grammar point expresses the ability or possibility of doing an action. It translates to 'can', 'be able to', or 'is possible' in English.",
    "ja": "この文法点は、ある行為を行う能力または可能性を表現します。英語では「できる」「可能である」などの意味になります。"
  },
  "structure": {
    "pattern": "Verb-る + ことができる",
    "components": [
      {
        "part": "Verb in る-form",
        "explanation": "The verb is used in its る-form before adding 'ことができる'.",
        "examples": [
          "話す (to speak)",
          "弾く (to play)"
        ]
      },
      {
        "part": "ことができる",
        "explanation": "This phrase follows the verb to indicate ability or possibility.",
        "examples": []
      }
    ]
  },
  "examples": [
