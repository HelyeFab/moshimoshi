rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Allow read access to all users for avatars
    match /avatars/{fileName} {
      allow read: if true;
      allow write: if request.auth != null &&
        (request.auth.uid == resource.metadata['uid'] ||
         request.auth.uid == request.resource.metadata['uid']);
      allow delete: if request.auth != null &&
        request.auth.uid == resource.metadata['uid'];
    }

    // Allow public read access to news audio files
    // Audio files are generated by Firebase Functions using Admin SDK (bypasses rules)
    // Path format: news-audio/{source}/{articleId}/{type}.mp3
    match /news-audio/{source}/{articleId}/{audioFile} {
      allow read: if true;  // Public read access for all users
      // Write access handled by Firebase Admin SDK (no explicit rule needed)
    }

    // Default rule for other files
    match /{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}