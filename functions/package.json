{
  "name": "functions",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "backfill:comics:dry": "npm run build && node lib/functions/src/scripts/backfillComicWordExplanations.js --dry-run",
    "backfill:comics": "npm run build && node lib/functions/src/scripts/backfillComicWordExplanations.js",
    "backfill:stories:dry": "npm run build && node lib/functions/src/scripts/backfillStoryWordExplanations.js --dry-run",
    "backfill:stories": "npm run build && node lib/functions/src/scripts/backfillStoryWordExplanations.js",
    "backfill:books:dry": "npm run build && node lib/functions/src/scripts/backfillBookWordExplanations.js --dry-run",
    "backfill:books": "npm run build && node lib/functions/src/scripts/backfillBookWordExplanations.js",
    "sync:word-status:dry": "npm run build && node lib/functions/src/scripts/syncWordExplanationStatus.js --dry-run",
    "sync:word-status": "npm run build && node lib/functions/src/scripts/syncWordExplanationStatus.js"
  },
  "engines": {
    "node": "20"
  },
  "main": "lib/functions/src/index.js",
  "dependencies": {
    "@google-cloud/pubsub": "^5.2.1",
    "cheerio": "^1.1.2",
    "firebase-admin": "^13.5.0",
    "firebase-functions": "^7.0.0",
    "kuromoji": "^0.1.2",
    "lru-cache": "^10.4.3",
    "openai": "^6.16.0",
    "stripe": "^18.5.0",
    "wanakana": "^5.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/kuromoji": "^0.1.3",
    "@types/node": "^24.5.2",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.6",
    "typescript": "^5.0.0"
  },
  "private": true
}
