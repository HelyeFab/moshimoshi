# Pre-commit hook: TypeScript + Lint checks
# Excludes: tests, functions, scripts

echo "🔍 Running TypeScript type check..."
npx tsc --noEmit --project tsconfig.precommit.json

if [ $? -ne 0 ]; then
  echo "❌ TypeScript errors found. Please fix before committing."
  exit 1
fi

echo "✅ TypeScript check passed!"

echo "✨ Running lint-staged..."
npx lint-staged
